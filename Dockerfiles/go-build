# syntax=docker/dockerfile:1

FROM golang:1.23 AS build

WORKDIR /app
COPY . .

ENV GOCACHE=/root/.cache/go-build

RUN --mount=type=cache,target="/root/.cache/go-build" \
    <<EOF
set -e
go build -o /bin/horizon-get horizon/get/horizon-get.go
go build -o /bin/horizon-compute horizon/compute/horizon-compute.go
EOF
